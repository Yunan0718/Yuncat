+  # misleading "app cannot be closed" prompt even though Yuncat is not running.
+  # Use the same upgrade strategy as Squirrel.Windows, Discord, Slack and Chrome:
+  # rename the entire existing directory to $OUTDIR.old.<timestamp>, install into
+  # a clean $OUTDIR, and schedule the old directory for deletion on reboot.
+  ${if} ${FileExists} "$OUTDIR\*.*"
