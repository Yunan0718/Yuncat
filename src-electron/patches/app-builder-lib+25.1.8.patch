+; Yuncat 强制关闭宏——在安装器初始化 / CHECK_APP_RUNNING / 卸载前调用。
+; 必须先于 CHECK_APP_RUNNING 宏定义，确保默认弹窗逻辑不会执行。
+; 路径：$APPDATA\Yuncat\.installer-close 须与 main.js 的 appDataDir 一致。
+!define INSTALLER_CLOSE_FLAG "$APPDATA\Yuncat\.installer-close"
+
+!macro FORCE_KILL_YUNCAT
+  ; 0) 安装前禁用开机自启，避免安装后/下次重启再次自动启动导致升级死循环。
+  ;    Electron app.setLoginItemSettings 在 Windows 默认写入 HKCU Run。
+  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "Yuncat"
+  ; 同时清理可能的手动 HKLM 条目（非默认，但为保险起见）
+  DeleteRegValue HKLM "Software\Microsoft\Windows\CurrentVersion\Run" "Yuncat"
+
+  ; 1) 写关闭标记文件，让运行中的 Yuncat 实例的 close 事件放行，不隐藏到托盘
+  ;    标记路径须与 main.js 的 appDataDir（%APPDATA%\Yuncat）一致
+  Delete "${INSTALLER_CLOSE_FLAG}"
+  nsExec::ExecToLog "\"$SYSDIR\cmd.exe\" /c if not exist \"$APPDATA\Yuncat\" mkdir \"$APPDATA\Yuncat\" & echo 1 > \"${INSTALLER_CLOSE_FLAG}\""
+
+  ; 2) 用 PowerShell 精确检测 Yuncat.exe 是否正在运行。
+  ;    避免 FindWindow 误匹配安装器自身窗口、浏览器窗口或其他含 "Yuncat" 标题的窗口。
+  ;    安装器进程名为 Yuncat_*-setup.exe，不会被 Get-Process Yuncat 匹配。
+  DetailPrint "Detecting running Yuncat process..."
+  ; PowerShell variables use $; in NSIS strings $ must be escaped as $$ so the shell sees $c.
+  nsExec::ExecToStack "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"try { $$c = (Get-Process -Name Yuncat -ErrorAction SilentlyContinue | Measure-Object).Count; [string]$$c } catch { '0' }\""
+  Pop $R0  ; PowerShell exit code
+  Pop $R1  ; stdout: process count as string (trimmed by nsExec)
+  ${If} $R0 == 0
+    ${If} $R1 == "0"
+      DetailPrint "No running Yuncat process detected"
+      Goto kill_done
+    ${EndIf}
+  ${EndIf}
+
+  ; 3) 优雅关闭：给实际 Yuncat 主窗口发 WM_CLOSE，触发 Electron 正常 quit → shutdownBackend
+  ;    对标 VS Code / Discord：先尝试 WM_CLOSE，让应用自己完成数据库/子进程清理。
+  FindWindow $0 "Chrome_WidgetWin_1" "Yuncat"
+  ${If} $0 != 0
+    DetailPrint "Requesting graceful shutdown (WM_CLOSE)..."
+    SendMessage $0 ${WM_CLOSE} 0 0 /TIMEOUT=3000
+  ${EndIf}
+
+  ; 4) 等待 Yuncat 优雅退出，最多 12s
+  ;    taskkill /IM /T 返回 128 表示进程已不存在（成功检测）。
+  StrCpy $R1 0
+wait_quit:
+  IntOp $R1 $R1 + 1
+  nsExec::Exec '"$SYSDIR\cmd.exe" /c taskkill /IM "Yuncat.exe" /T /fi "USERNAME eq %USERNAME%"'
+  Pop $R0
+  ${If} $R0 == 128
+    DetailPrint "Yuncat exited gracefully"
+    Goto quit_done
+  ${EndIf}
+  ${If} $R1 < 8
+    Sleep 1500
+    Goto wait_quit
+  ${EndIf}
+  DetailPrint "Graceful shutdown timed out, switching to force kill"
+quit_done:
+
+  ; 5) 强制结束进程树，循环确认最多 5 次
+  ;    不强杀 SearchIndexer/SearchProtocolHost（SYSTEM 服务，主流安装器从不杀它），
+  ;    文件锁问题交给 Windows Restart Manager API 让系统
+  ;    自己结束占用 Yuncat.exe 的进程（VS Code / Chrome / Windows Update 同款）。
+  IfFileExists "$INSTDIR\resources\restartmanager-kill.ps1" 0 +2
+    nsExec::ExecToLog "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$INSTDIR\resources\restartmanager-kill.ps1\" -TargetPath \"$INSTDIR\Yuncat.exe\""
+  StrCpy $R1 0
+kill_loop:
+  IntOp $R1 $R1 + 1
+  nsExec::ExecToLog '"$SYSDIR\cmd.exe" /c taskkill /F /IM "Yuncat.exe" /T /fi "USERNAME eq %USERNAME%"'
+  Pop $R0
+  ${If} $R0 == 128
+    DetailPrint "No running Yuncat.exe"
+    Goto kill_done
+  ${EndIf}
+  ${If} $R0 == 1
+    ; taskkill 返回 1 通常表示访问被拒绝（权限不足）。
+    ; 如果 Yuncat 以管理员运行而安装器没有，无论如何都杀不掉。
+    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Yuncat 无法关闭：权限不足。$\n$\n当前运行的 Yuncat 可能以管理员权限启动，而安装程序未获得提升。$\n请以管理员身份重新运行安装程序，或在任务管理器中手动结束 Yuncat 后点击重试。" /SD IDCANCEL IDRETRY kill_loop
+    Quit
+  ${EndIf}
+  DetailPrint "Yuncat still running, retrying force kill ($R1/5)..."
+  Sleep 1500
+  ; PowerShell 兜底：强制结束所有名为 Yuncat 的进程
+  nsExec::ExecToLog 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Process Yuncat -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 800"'
+  Sleep 2000
+  ${If} $R1 > 4
+    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Yuncat 无法关闭。$\n$\n可能原因：Yuncat 进程卡死或以更高权限运行。$\n请打开任务管理器结束 Yuncat 进程后点击重试。" /SD IDCANCEL IDRETRY kill_loop
+    Quit
+  ${EndIf}
+  Goto kill_loop
+
+kill_done:
+  ; 6) 清理关闭标记
+  Delete "${INSTALLER_CLOSE_FLAG}"
+!macroend
 
