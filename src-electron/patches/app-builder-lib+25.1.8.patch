+        DetailPrint `NSIS rename failed, trying PowerShell directory move...`
+        nsExec::ExecToLog "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"try { Move-Item -LiteralPath '$OUTDIR' -Destination '$R9' -Force -ErrorAction Stop } catch { exit 1 }\""
